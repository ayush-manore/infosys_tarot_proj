# =================================================================
# Palmistry & Tarot Intelligence Platform — Environment Configuration
# =================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =================================================================

# ---- Application ----
APP_NAME=Palmistry & Tarot Intelligence Platform
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Security ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=palmistry_tarot
POSTGRES_USER=admin
POSTGRES_PASSWORD=secret123
DATABASE_URL=postgresql+asyncpg://admin:secret123@localhost:5432/palmistry_tarot

# ---- MongoDB ----
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DB=palmistry_tarot
MONGODB_URL=mongodb://localhost:27017/palmistry_tarot

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---- Google OAuth2 ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- Cloud Storage (Future) ----
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=

# ---- Google Gemini AI ----
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ---- Frontend (Next.js) ----
# Set this in frontend/.env.local for production:
# NEXT_PUBLIC_API_BASE=https://your-backend-url.com/api/v1
