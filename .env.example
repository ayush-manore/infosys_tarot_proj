# ====================================================================
# MysticAI - Docker Compose Environment Variables
# ====================================================================
# This file is read by docker-compose.yml to inject secrets into containers.
# Copy this to `.env` and fill in your values before running `docker compose up`.

# Google Gemini AI Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Gmail SMTP Notifications (Google Account → Security → App Passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
